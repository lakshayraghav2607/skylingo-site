# ---- OS junk ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---- Editor / IDE ----
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# ---- Logs & temp files ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tmp
*.bak
*.cache

# ---- Node (only if you ever add tooling) ----
node_modules/
npm-debug.log
yarn.lock
package-lock.json

# ---- Local env / secrets ----
.env
.env.*
!.env.example

# ---- Build output (not used for a plain static site) ----
dist/
build/

# ---- Anything you drop in locally but don't want public ----
_notes/
scratch/
*.psd
*.ai

# Keep these tracked even though they look "hidden":
!.nojekyll
!.gitignore
